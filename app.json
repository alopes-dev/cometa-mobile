{
  "expo": {
    "name": "Cometa",
    "slug": "cometa",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "cometa",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "so.sof.cometa"
    },
    "android": {
      "package": "so.sof.cometa",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
